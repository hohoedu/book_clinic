                <mxCell id="quiz_g2" value="최종 점수 = max(이번 점수, 기존 최종)&#xa;처음 점수는 고정 — 절대 안 바뀜" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
