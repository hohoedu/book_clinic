                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_11" value="있음" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#82b366;fontColor=#2d6a2d;" edge="1" parent="1" source="advgate_v4" target="advgate_vp">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="advgate_vn1" value="날이 바뀌면 심화 미응시여도 통과시킨다 (사용자 확정 2026-08-31) —&#xa;어제 못 푼 심화 때문에 오늘 첫 책을 못 받는 상황을 막는다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="830" y="500" width="420" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="advgate_vn2" value="출석체크 키오스크(/attendance/enter)는 이 판정을 호출하지 않는다 —&#xa;버튼이 없는 기기라 막히면 학생이 빠져나갈 방법이 없다.&#xa;키오스크 입실은 항상 다음 책을 추천한다(2026-08-28)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="830" y="600" width="420" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="advgate_vn3" value="알려진 이슈&#xa;&#xa;불합격(RETRY) 학생이 결과 화면을 벗어나 일반 홈으로 가면&#xa;AWAITING_NEXT(&#39;책 추천받기&#39;)로 떨어져, 재도전 진입 경로가&#xa;결과 화면 재도전 버튼 하나뿐이다. 의도된 동작으로 보고 유지 중." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="80" y="870" width="620" height="130" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
