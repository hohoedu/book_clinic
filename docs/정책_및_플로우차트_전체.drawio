                <mxCell id="reservation_r7" value="예약 INSERT + 상태로그(RESERVED)&#xa;날짜는 요청이 아니라 슬롯에서 가져옴" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
