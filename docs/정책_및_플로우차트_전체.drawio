                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="refund_xf2" value="환불 불가&#xa;환불할 수 있는 결제가 아닙니다" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="940" y="309" width="300" height="60" as="geometry"/>
