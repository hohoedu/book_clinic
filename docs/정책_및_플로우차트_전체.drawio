                <mxCell id="session_ex8" value="400 이용권이 모두 소진되었습니다.&#xa;재결제 후 이용해주세요.&#xa;→ 트랜잭션 전체 롤백" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
