                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_r6" value="슬롯 정원이 남았는가?&#xa;(incrementReservedCount)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="230" y="860" width="400" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e_8" value="" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reservation_r5" target="reservation_r6">
                    <mxGeometry relative="1" as="geometry"/>
