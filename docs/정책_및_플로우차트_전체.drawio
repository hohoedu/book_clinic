                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="quiz_w1" value="WRONG_ONLY — 틀린 문제 다시 풀기" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3d5a80;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1100" y="640" width="340" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="quiz_w2" value="점수 · 등급 · 뱃지 · 카드&#xa;어떤 것도 바꾸지 않는다&#xa;&#xa;화면에는 원래(고정) 등급을 그대로 보여주고,&#xa;이번에 몇 개 맞혔는지와 남은 오답만 갱신한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="1100" y="695" width="340" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e_18" value="WRONG_ONLY" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="quiz_z4" target="quiz_w1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="quiz_nn1" value="재도전은 &#39;올라가기만&#39; 한다 (2026-08-28 최종)&#xa;독서친구 → 재도전 불합격처럼 내려가는 방향은 반영하지 않는다.&#xa;등급이 오르면 기본 뱃지도 상위로 교체 —&#xa;그래야 grade · 뱃지 · &#39;독서왕 횟수&#39;(grade=&#39;KING&#39;)가 항상 일치한다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="120" y="1200" width="470" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="quiz_nn2" value="첫 제출 불합격도 grade=&#39;RETRY&#39;로 저장한다 (2026-09-02, 예전엔 null)&#xa;&#39;완독 성공&#39; 판정은 grade != null 이 아니라 isPassGrade(KING/FRIEND)로 한다.&#xa;getQuizMode · getLastResult · submitQuiz · 프론트 renderCompletion 모두 이 기준." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="620" y="1200" width="470" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="quiz_nn3" value="mode 파라미터는 WRONG_ONLY만 의미가 있다.&#xa;그 외/생략이면 서버가 제출 회차로 FIRST/RETRY를 판단한다&#xa;(클라이언트가 mode를 위조해도 첫 제출은 첫 제출)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="1120" y="1200" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="quiz_nn4" value="불합격이어도 다음 입실 때 다음 책을 받는다.&#xa;재도전은 결과 화면 / 완료 화면 버튼에서만 —&#xa;책이 아직 손에 있을 때만 이어서 푼다.&#xa;KING은 재도전 버튼이 없다(심화만 남음)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="120" y="1350" width="470" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="quiz_nn5" value="중복 뱃지 방어&#xa;첫 시도의 미제출 문항까지 항상 로그를 남기는 이유 —&#xa;실제 문항과 다른 qnum만 담은 &#39;빈 제출&#39;을 반복해&#xa;countPriorAttempts를 속이고 뱃지를 중복 획득하는 걸 막는다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="620" y="1350" width="470" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="09. 심화 문제 (qlevel=02)" id="adv">
