                    <mxGeometry x="940" y="419" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_14" value="예" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="refund_f3" target="refund_xf3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="refund_xf4" value="환불 불가&#xa;승인 정보가 없어 환불할 수 없습니다" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="940" y="537" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_15" value="아니오" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="refund_f4" target="refund_xf4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="refund_xf6" value="환불 불가&#xa;&#39;환불 가능 기간이 지났거나&#xa;사용 횟수가 초과되었습니다&#39;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="940" y="742" width="300" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="e_16" value="없음" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="refund_f6" target="refund_xf6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="refund_xf9" value="confirmRefundFailed&#xa;→ 거절 사유 그대로 노출" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="940" y="1037" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_17" value="거절/오류" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="refund_f9" target="refund_xf9">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="refund_r1" value="환불 규정 (2026-08-05 — 날짜 조건 폐지, 사용 횟수만으로 판정)&#xa;&#xa;  이용권 0회 사용 →  100% 환불&#xa;  1회 사용        →   75% 환불&#xa;  2회 사용        →   50% 환불&#xa;  3회 이상        →  규정에 맞는 행이 없어 자연히 환불 불가&#xa;&#xa;usedDays(경과 일수)는 판정에 쓰지 않지만&#xa;payment_cancel 감사 스냅샷에는 계속 남긴다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="120" y="1260" width="520" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="refund_r2" value="환불은 결제 1건당 1번만 (2026-08-05)&#xa;&#xa;refund_amount가 조금이라도 있으면 그걸로 끝이다.&#xa;부분환불(75%) 후 남은 잔액을 다시 계산해 또 내주면,&#xa;두 번 요청하는 것만으로 사실상 100% 환불이 되어&#xa;&#39;1회 사용 시 75%까지만&#39; 규정이 무의미해진다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="680" y="1260" width="460" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="refund_r3" value="규정 테이블은 활성 규정을 priority 순으로 훑는다.&#xa;조건에 처음 맞는 규정 하나만 적용하고 멈춘다.&#xa;어디에도 안 걸리면 환불 불가다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="1180" y="1260" width="250" height="180" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="14. 학생 앱 홈 상태머신" id="homestate">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1150" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t_1" value="홈 상태 — 기기에 따라 다른 두 갈래" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="40" y="24" width="1200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="t_2" value="2026-07-29 &#39;입실&#39;과 &#39;책 추천&#39;을 분리했다. 홈 진입 = 자동 추천이 아니다" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="40" y="56" width="1240" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="homestate_h1" value="출석체크 키오스크  /attendance/enter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3d5a80;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="120" width="560" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="homestate_k1" value="getHomeState(studentId)&#xa;※ 항상 입실 처리(enterSession)한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="80" y="165" width="560" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="homestate_k2" value="PENDING 추천이 있는가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="250" y="245" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="homestate_k3" value="READING — 그 책 표시&#xa;(ensureActiveLoan으로 대여 상태 복구)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="345" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="homestate_k4" value="완독(DONE) 이력이 있는가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="250" y="435" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="homestate_k5" value="AWAITING_NEXT — 직전 책 표시&#xa;&#39;책 추천받기&#39; 버튼 대기" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="250" y="535" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="homestate_k6" value="생애 첫 로그인&#xa;→ 즉시 recommendBook → READING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
