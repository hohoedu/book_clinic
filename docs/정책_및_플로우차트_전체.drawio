                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="monitor_n1" value="&#39;결과 확인중&#39;(result_viewed_at 기반)은 폐지됐다 —&#xa;제출 즉시 결과 상태로 넘어간다.&#xa;result_viewed_at 컬럼과 호출은 no-op로 남아 있다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="120" y="940" width="440" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="monitor_n2" value="시간초과는 아직 제출 전(독서 중)일 때만 의미가 있다 —&#xa;제출했다면 독서는 이미 끝난 것이므로 결과 상태가 이긴다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="600" y="940" width="440" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="monitor_n3" value="&#39;문제 푸는 중&#39; 회차 표기&#xa;clinic_session.quiz_qlevel + markQuizStarted(studentId, qlevel).&#xa;기본 = basicAttemptRounds + 1 = 현재 회차, 심화면 &#39;심화&#39;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="940" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="monitor_n4" value="상단 chip 집계 (buildCounts)&#xa;&#xa;notEntered / reading / quizInProgress / timeOver /&#xa;retryNeeded / completed(KING·FRIEND·ADV_DONE·ADV_KING)&#xa;EXITED는 별도 chip 없음.&#xa;독서일지 미등록 카운트는 미입실 카드를 제외하고 센다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="120" y="1060" width="440" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="monitor_n5" value="실시간 갱신 3중 경로&#xa;&#xa;Firestore 구독(주) + 30초 백업 폴링 + 브라우저 로컬 카운트업.&#xa;MonitorSyncService.syncCard/toBookMaps는 필드를 수동 매핑한다 —&#xa;새 필드를 빠뜨리면 실시간 갱신 때 그 값만 사라진다.&#xa;(Firestore에는 java.time 타입을 그대로 넣을 수 없어 Map으로 평탄화)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="600" y="1060" width="460" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="monitor_n6" value="센터별 스코핑&#xa;&#xa;로그인 직원의 centerCode 기준 자동 필터.&#xa;예약 조회 + Firestore 문서의 centerCode + 구독 where 조건.&#xa;sessionDate·centerCode 두 등가 필터라 복합 인덱스가 필요할 수 있다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="1060" width="400" height="130" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
