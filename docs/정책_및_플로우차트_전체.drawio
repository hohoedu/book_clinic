                <mxCell id="e_9" value="재도전" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="adv_s3" target="adv_b1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_10" value="" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adv_b1" target="adv_b2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_11" value="" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="adv_b2" target="adv_b3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="adv_c1" value="틀린 문제 다시 풀기" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3d5a80;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="760" y="560" width="280" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="adv_c2" value="점수 · 뱃지 어떤 것도&#xa;바꾸지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="760" y="615" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_12" value="WRONG_ONLY" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="adv_s3" target="adv_c1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="adv_d1" value="결과 화면에 함께 내려주는 것&#xa;&#xa;• 현재 레벨 (안 채우면 HTML placeholder &#39;Lv. 2&#39;가 그대로 노출)&#xa;• 그 책의 심화 뱃지 (새로 받은 게 없어도 보상 칸 유지)&#xa;• 기본 등급 · 기본 오답 목록&#xa;  → 심화왕이어도 기본이 독서왕이 아니면&#xa;    기본 &#39;틀린 문제 다시 풀기&#39; 버튼이 남아야 하므로&#xa;• 그 책에서 이미 받은 카드 (2026-09-03, 카드 칸이 통째로 비지 않게)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="560" width="340" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="adv_e1" value="심화에는 커트라인이 없다 — 고쳐진 버그&#xa;&#xa;예전엔 awardAdvancedBadge에 correct &lt; passLine 가드가 있어&#xa;커트라인 미달이면 뱃지를 안 줬는데, 모니터링은 제출만 있으면&#xa;ADV_DONE으로 찍고 있었다 → &#39;카드엔 심화완료인데 뱃지는 없는&#39;&#xa;불일치. 가드를 제거해 정리했다(두 메서드에서 passLine 파라미터도 삭제)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="100" y="1000" width="560" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="adv_e2" value="심화는 1회성 도전이다&#xa;&#xa;결과 화면의 심화 버튼은 첫 시도 후 사라진다(advancedAvailable) —&#xa;기본 문제처럼 &#39;등급을 올리는&#39; 업그레이드 경로가 없다.&#xa;심화는 카드도 주지 않는다(카드는 기본 첫 제출 때 책당 1장)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="700" y="1000" width="560" height="140" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="10. 보상 정책 (등급·뱃지·카드·레벨)" id="reward">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1250" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t_1" value="보상 체계 — 등급 · 뱃지 · 독서 카드 · 레벨/칭호" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="40" y="24" width="1200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="t_2" value="2026-07-27 전면 재편 → 2026-09-02 뱃지 4종화. EXP는 폐지됨" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="40" y="56" width="1240" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="reward_h1" value="등급  recommend_log.grade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3d5a80;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="110" width="420" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="reward_t1" value="RETRY   재도전 필요 — 합격선 미만 (rank 0)&#xa;FRIEND  독서친구 — 합격선 이상 (rank 1)&#xa;KING    독서왕 — 만점 (rank 2)&#xa;&#xa;합격선 = ceil(전체 문항 수 × 2/3)&#xa;  12문항 → 8개 · 15문항 → 10개&#xa;&#xa;재도전으로 올라가기만 한다. 내려가지 않는다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="60" y="155" width="420" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="reward_h2" value="뱃지  erp_bookstore_badge (책마다 부여)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3d5a80;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="540" y="110" width="420" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="reward_t2" value="1  독서완료   기본 문제를 풀면 — 합격/불합격 무관&#xa;2  독서왕     기본 만점&#xa;3  심화완료   심화를 풀면 — 합격선 없음&#xa;4  심화왕     심화 만점&#xa;&#xa;책(content)마다 기본 1개(1~2 택1) + 심화 1개(3~4 택1)&#xa;student_badge PK에 content_id 포함&#xa;첫 시도 결과로 정해지고, 재도전으로 올라가기만 한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="540" y="155" width="420" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="reward_h3" value="독서 카드  erp_bookstore_student_card" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3d5a80;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="110" width="420" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="reward_t3" value="NORMAL  완독한 책마다 1장 (책당 고정 1종)&#xa;RARE    NORMAL 10장마다 추가 지급 (책과 무관)&#xa;&#xa;기본 문제 첫 제출(DONE) 시점에 지급&#xa;CARD_SET_SIZE = 10&#xa;&#xa;NORMAL 10장 = 오프라인 실물 카드 1장&#xa;시스템은 진행도·달성 표시까지만 — 실물 지급은 수동&#xa;결과 화면 팝업은 정체를 가린다(??? + N/10장)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="155" width="420" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="reward_h4" value="레벨 / 칭호  erp_bookstore_level" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3d5a80;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="60" y="380" width="900" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="reward_t4" value="레벨 = min(12, ⌊해당 학년 완독(DONE) 권수 ÷ 학년별 필요 권수⌋ + 1)&#xa;&#xa;· EXP 완전 폐지. student_info·exp_rule 테이블도 폐지 — 로그에서 매번 재계산한다&#xa;· 단계 = 학생 학년(01~06), 각 단계마다 레벨 1~12 → 칭호 6단계 × 12 = 72종&#xa;· 추천이 학생 학년 = 도서 학년을 맞춰주므로 학년이 섞이지 않는다&#xa;  (진도가 빠르면 학생 학년 자체를 상위로 변경)&#xa;· 레벨 규칙은 DB가 아니라 Java 상수 ClinicService.LEVEL_RULES (어드민 편집 화면이 없어서)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="60" y="425" width="900" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="reward_t5" value="학년별 레벨업 필요 권수 / 단계명&#xa;&#xa;01 초1  8권   기초 — 읽는 즐거움을 알아가는 단계&#xa;02 초2  8권   성장 — 책 속 지식과 생각을 모으며 성장하는 단계&#xa;03 초3  5권   탐구 — 스스로 질문하고 파고들며 사고를 넓히는 단계&#xa;04 초4  4권   심화 — 지식을 깊이 있게 이해하고 연결하는 단계&#xa;05 초5  4권   통찰 — 어휘와 문해력으로 글의 본질을 읽어내는 단계&#xa;06 초6  4권   마스터 — 폭넓은 사고로 독서를 완성하는 단계" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="380" width="420" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="reward_t6" value="독서탐험 지도 — 학년별 연간 목표 완독 권수 (2026-08-25 확정)&#xa;&#xa;초1 96  ·  초2 96  ·  초3 60  ·  초4 50  ·  초5 50  ·  초6 50&#xa;중등(07)은 별도 확정 전이라 초6과 같은 값을 임시 사용" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="60" y="620" width="900" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="reward_w1" value="주의 — 뱃지명은 아이콘 이미지에 그려진 문구와 반드시 같아야 한다&#xa;결과 화면이 이미지와 이름을 나란히 보여주기 때문. 새 아트를 받으면 DB 이름도 맞춘다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="620" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="reward_w2" value="주의 — 등급명 ≠ 뱃지명&#xa;recommend_log.grade는 KING/FRIEND/RETRY 그대로이고,&#xa;결과 화면 hero는 여전히 &#39;독서친구 달성!&#39;이라고 뜬다.&#xa;뱃지만 &#39;독서완료&#39;다. 통일 여부 미정." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="60" y="780" width="460" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="reward_w3" value="아이콘 용량&#xa;원본(1254×1254, 합 6.8MB)은 docs/images/badges-original/에 보관하고&#xa;서비스용은 256×256로 축소(합 413KB).&#xa;모니터링은 카드마다 뱃지를 그려 한 화면에 수십 장이 동시 로드된다 —&#xa;원본 그대로면 태블릿에서 느려진다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="560" y="780" width="460" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="reward_w4" value="gradeUpgraded 분기에는 &#39;뱃지가 실제로 바뀔 때만 교체&#39;하는 가드가 있다.&#xa;불합격 → 독서친구는 등급만 오르고 뱃지는 그대로(둘 다 1번)라,&#xa;가드가 없으면 &#39;뱃지 획득!&#39;이 또 뜬다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="1060" y="780" width="400" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="reward_w5" value="보상 테이블 4개&#xa;&#xa;level (칭호 마스터)  ·  badge (뱃지 마스터)&#xa;student_badge (부여 이력)  ·  student_card (카드 지급 이력)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="60" y="950" width="460" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="11. 모니터링 카드 상태 6종" id="monitor">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t_1" value="실시간 모니터링 카드 상태 판정 — resolveCardStatus" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="40" y="24" width="1200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="t_2" value="2026-08-28 확정. 위에서부터 먼저 걸리는 것이 이긴다 (우선순위 판정)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
