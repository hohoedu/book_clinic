                <mxCell id="quiz_g1" value="RETRY — 재도전" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#3d5a80;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
