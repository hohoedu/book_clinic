                <mxCell id="journey_j9c" value="불합격 → grade=RETRY (재도전 필요)&#xa;뱃지 1 독서완료" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" parent="1" vertex="1">
