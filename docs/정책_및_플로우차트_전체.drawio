                <mxCell id="e_9" value="" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reservation_r6" target="reservation_r7">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_r8" value="예약 완료 → 모니터링 &#39;미입실&#39; 카드 생성" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="230" y="1092" width="400" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="e_10" value="" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="reservation_r7" target="reservation_r8">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_x2" value="404 존재하지 않는 회차입니다" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="880" y="339" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e_11" value="아니오" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="reservation_r2" target="reservation_x2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_x3" value="400 이미 종료된 회차입니다" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="880" y="459" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e_12" value="아니오" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="reservation_r3" target="reservation_x3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_x4" value="400 해당 월 이용권이 없습니다 (상한 0)&#xa;또는 그 달 예약 가능 횟수 초과" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="880" y="589" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e_13" value="아니오" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="reservation_r4" target="reservation_x4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_x5" value="400 하루 4회차까지만 예약할 수 있습니다" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="880" y="729" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e_14" value="아니오" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="reservation_r5" target="reservation_x5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_x6" value="400 마감되었습니다 (정원 초과)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="880" y="865" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="e_15" value="아니오" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="reservation_r6" target="reservation_x6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_rn1" value="월 상한은 홀드/차감을 하지 않는다&#xa;예약 취소가 잦아 되돌림 비용이 커서, 실제 차감은&#xa;입실 시점(enterSession)에만 일어난다.&#xa;기준 달은 &#39;오늘&#39;이 아니라 슬롯의 service_date가 속한 달 —&#xa;4주 일괄 예약이 월 경계를 넘어도 각자 자기 달 상한을 탄다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="1230" y="339" width="430" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_rn2" value="동시성 방어&#xa;(student_id, service_date) 유니크 인덱스를 제거한 자리를&#xa;학생 행 락이 대신 지킨다. &#39;N건까지&#39;는 유니크로 표현 불가.&#xa;UX_reservation_slot_student(같은 회차 중복예약)는 유지." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="1230" y="490" width="430" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_rb" value="4주 일괄 예약 미리보기 (previewBatch)&#xa;&#xa;같은 요일·회차를 4주치 훑어 주차별 상태를 돌려준다&#xa;  OPEN — 예약 가능&#xa;  DAY_CONFLICT — 그날 이미 4회차&#xa;  MONTH_FULL — 그 달 상한 소진(배치 내 앞선 OPEN도 누적 카운트)&#xa;  NO_PASS — 그 달 이용권 없음&#xa;  CLOSED / FULL — 종료된 회차 · 정원 마감" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="60" y="1140" width="480" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="reservation_rc" value="취소 · 노쇼&#xa;&#xa;• 학생 취소 / 직원 대리 취소 → status=CANCELED + 로그&#xa;• 노쇼 배치(ReservationNoShowJob): ends_at 지났는데&#xa;  RESERVED로 남은 예약 → NOSHOW (SYSTEM, &#39;미입실 자동 처리&#39;)&#xa;• NOSHOW는 월 상한 계산에 포함된다(status &lt;&gt; CANCELED)&#xa;• 입실 1회로 그날 예약이 전부 ATTENDED가 되므로&#xa;  나중 회차가 노쇼로 잡히지 않는다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="600" y="1140" width="460" height="170" as="geometry"/>
                </mxCell>
