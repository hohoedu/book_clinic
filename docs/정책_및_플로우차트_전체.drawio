                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="session_en1" value="입실 1회 = 그날 예약 전부 출석 (2026-08-28)&#xa;하루 4회차까지 예약 가능한데 입실은 1회뿐이라,&#xa;첫 입실 한 번으로 그날 RESERVED를 모두 ATTENDED로 올린다.&#xa;두 번째 회차 시간대가 아직 아니어도 출석으로 친다." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="960" y="660" width="400" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="session_en2" value="이용권은 &#39;그날 출석 회차 수&#39;만큼 깎는다.&#xa;재입실 시엔 (목표 − 이미 차감분)만 추가로 깎는다.&#xa;모자라면 있는 만큼만 깎고 입실은 허용,&#xa;하나도 못 깎았고 남은 게 없으면 -1로 차단." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="960" y="790" width="400" height="100" as="geometry"/>
                </mxCell>
