                <mxCell id="journey_j1" value="① 결제 (PG 또는 서당 청구)&#xa;→ 이용권(pass) 발급, billing_ym 단위" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
