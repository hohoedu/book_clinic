                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="refund_f8" value="openCancel → PG 취소 API 호출" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="180" y="962" width="480" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="e_10" value="" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="refund_f7" target="refund_f8">
