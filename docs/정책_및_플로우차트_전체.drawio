                </mxCell>
                <mxCell id="journey_j9b" value="합격 → grade=FRIEND (독서친구)&#xa;뱃지 1 독서완료" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" parent="1" vertex="1">
