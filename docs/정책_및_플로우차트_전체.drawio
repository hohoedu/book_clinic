                <mxCell id="adv_b2" value="최종 점수만 max로 갱신&#xa;(advanced_final_correct_cnt)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="430" y="615" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="adv_b3" value="뱃지 업그레이드&#xa;심화완료 → 심화왕 (오를 때만)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
