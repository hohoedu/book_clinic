                <mxCell id="t_2" value="각 단계의 상세는 뒤 페이지 참고. 모든 시각 판단은 KST(KstClock) 기준" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#666666;" parent="1" vertex="1">
