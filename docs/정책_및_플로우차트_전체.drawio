                    <mxGeometry x="1150" y="335" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_16" value="차단" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="recommend_mg" target="recommend_mgx">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_17" value="아니오" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#82b366;fontColor=#2d6a2d;" edge="1" parent="1" source="recommend_m2" target="recommend_m3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="recommend_mx3" value="400 오늘 추천받을 수 있는 책&#xa;N권을 모두 받으셨습니다" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="850" y="470" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_18" value="초과" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="recommend_m3" target="recommend_mx3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="recommend_mx7" value="404 추천할 수 있는&#xa;도서가 더 이상 없습니다" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="850" y="850" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_19" value="없음" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="recommend_m7" target="recommend_mx7">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="recommend_m8n" value="그 item_id를 제외 목록에 넣고&#xa;다음 후보로 (경합 = 그 사이 소진)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="850" y="975" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e_20" value="실패" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="recommend_m8" target="recommend_m8n">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_21" value="재시도 루프" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="recommend_m8n" target="recommend_m6">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1200" y="1005"/>
                            <mxPoint x="1200" y="779"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="recommend_n1" value="추천 상한 = MAX_RECOMMENDATIONS_PER_SLOT(2) × 그날 ATTENDED 회차 수.&#xa;하루 4회차면 최대 8권. recommend_log가 회차와 연결돼 있지 않아&#xa;&#39;회차별 정확히 2권&#39;이 아니라 그날 총량으로만 제한한다(사용자 확정)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="80" y="1400" width="470" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="recommend_n2" value="반납이 일어나는 시점은 이 세 곳뿐이다&#xa;  1) 학생 QR 퇴실&#xa;  2) 직원 퇴실 처리&#xa;  3) 새 책 추천 (다 읽은 책을 여기서 놓아준다)&#xa;완독(DONE) 자체는 반납을 유발하지 않는다 — 재도전 대비." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="80" y="1530" width="470" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="recommend_n3" value="추천 도서 교체 replaceRecommendedBook (2026-09-02)&#xa;서가에 실제로 없거나 훼손된 책일 때 직원이 실행.&#xa;일부러 @Transactional을 걸지 않았다 —&#xa;  1) 취소 + 재고 차감 (없는 책이라는 사실은 그대로 유효)&#xa;  2) 다음 책 추천 (실패할 수 있음)&#xa;한 트랜잭션이면 2 실패 시 1까지 되돌아가 못 읽는 책이 다시 추천된다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="600" y="1400" width="500" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="recommend_n4" value="생애 첫 로그인은 게이트를 타지 않고 즉시 추천한다&#xa;(보여줄 &#39;직전 책&#39;이 없어 AWAITING_NEXT가 어색하므로)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="600" y="1580" width="500" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
