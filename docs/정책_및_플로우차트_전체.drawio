                <mxCell id="e_3" value="" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="journey_j0" target="journey_j1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="journey_j2" value="② 회차 예약&#xa;월 상한 = 그 달 이용권 total_count 합&#xa;하루 최대 4회차" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="230" y="330" width="380" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="e_4" value="" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="journey_j1" target="journey_j2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="journey_j3" value="③ 입실 (키오스크 또는 앱 로그인)&#xa;예약 필수 · 회차 시간대(시작 10분 전~종료)&#xa;입실 1회 = 그날 예약 회차 전부 ATTENDED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="230" y="448" width="380" height="86" as="geometry"/>
                </mxCell>
