                <mxCell id="quiz_g3" value="grade = higherGrade(기존, 이번)&#xa;RETRY(0) &lt; FRIEND(1) &lt; KING(2) — 오를 때만" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="470" y="777" width="300" height="62" as="geometry"/>
                </mxCell>
