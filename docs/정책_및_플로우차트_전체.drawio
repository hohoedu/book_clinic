                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="journey_j4" value="④ 이용권 차감 = 그날 출석 회차 수만큼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
