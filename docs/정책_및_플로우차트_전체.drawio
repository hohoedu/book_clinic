                <mxCell id="quiz_g5" value="기본 뱃지 교체&#xa;(deleteBasicBadge → awardBookBadge)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
