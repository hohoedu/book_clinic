<mxfile host="app.diagrams.net">
  <diagram name="더미데이터 ERD (센터·사용자·학생)" id="dummy-data-erd">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="tblCenter" value="erp_center&#10;&#10;id (PK)&#10;center_code (UNIQUE) — 예: PUS001&#10;center_name / director_name / ...&#10;&#10;(코드상 미조회 — 값 그대로 유지 중)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="260" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tblUser" value="erp_user (ERP 관리자 계정)&#10;&#10;id (PK)&#10;center_code — 본사=PUS001만 마스터 편집권&#10;user_id / user_name — 로그인 계정&#10;password_hash / salt — 로그인 검증&#10;role_key / is_han / is_book / is_clinic / use_yn" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="320" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tblStudent" value="erp_student&#10;&#10;id (PK, 내부용)&#10;center_code — 소속 센터&#10;student_id — 앱/추천 로직 연결 키 (UNIQUE 아님)&#10;student_name — 표시용 이름&#10;app_id — 학생 로그인 아이디(appId)&#10;grade_key — 학년(S코드 01~07), 추천 로직 실사용&#10;address/gender/birth/... — 저장만, 코드 미사용" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="460" y="260" width="320" height="190" as="geometry" />
        </mxCell>

        <mxCell id="tblInfo" value="erp_bookstore_student_info&#10;&#10;student_id (PK) — erp_student.student_id&#10;level_no / exp / books_read&#10;character_id (FK, nullable)&#10;&#10;※ 이 행이 없으면 학생 로그인 시 404" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="880" y="300" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="rel1" value="center_code&#10;(값 연결, FK 아님) 1:N" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;dashed=1;endArrow=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tblCenter" target="tblUser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel2" value="center_code&#10;(값 연결, FK 아님) 1:N" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;dashed=1;endArrow=none;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tblCenter" target="tblStudent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel3" value="student_id (값 연결, FK 아님) 1:1&#10;— 학생 등록 시 반드시 같이 생성" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="tblStudent" target="tblInfo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="더미 데이터 입력 시 반드시 채워야 하는 값:&#10;center_code, student_id, app_id, grade_key (학생) / user_id, password_hash, role_key (사용자)&#10;비어 있으면 로그인/추천 로직이 정상 동작하지 않습니다." style="shape=note;whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;size=16;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="740" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
