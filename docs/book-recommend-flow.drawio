<mxfile host="app.diagrams.net">
  <diagram name="도서 추천 프로세스" id="book-recommend-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="학년별 권장도서 순위&#10;최상위 책부터 시작" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="40" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="이 책을&#10;읽었는가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="현재 사용 가능한가?&#10;(대여중·분실 등 아님)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="300" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="직전 독서 책과&#10;분류가 동일한가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="450" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="직전 독서 책과&#10;장르가 동일한가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="600" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="nEnd" value="이 책을 추천 도서로 확정" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="750" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="nNext" value="다음 순위 책으로 이동" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="380" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- main path -->
        <mxCell id="e1" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="n1" target="d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="아니오 (안 읽음)" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="예 (사용 가능)" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="아니오 (동일하지 않음)" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="d3" target="d4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="아니오 (동일하지 않음)" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="d4" target="nEnd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- skip-to-next paths -->
        <mxCell id="e_skip1" value="예 (읽음)" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="d1" target="nNext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_skip2" value="아니오 (사용 불가)" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="d2" target="nNext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_skip3" value="예 (동일함)" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="d3" target="nNext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_skip4" value="예 (동일함)" style="rounded=0;orthogonalEdgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;" edge="1" parent="1" source="d4" target="nNext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- loop back -->
        <mxCell id="e_loop" value="다음 순위 책 재검사" style="rounded=0;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="nNext" target="d1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
